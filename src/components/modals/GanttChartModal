// src/components/modals/GanttChartModal.jsx
import React, { useMemo } from 'react';
import { X, Calendar, Layers, Clock } from 'lucide-react';
import { COLUMNS } from '../../utils/constants';

export default function GanttChartModal({ mainTask, subtasks, onClose }) {
    
    // --- 1. TIMELINE CALCULATION ---
    const { days, months, timelineStart, timelineEnd } = useMemo(() => {
        // Collect all dates to find min and max
        const allDates = [];
        const addDate = (dateStr) => {
            if (dateStr) {
                const d = new Date(dateStr);
                d.setHours(0,0,0,0);
                allDates.push(d);
            }
        };

        addDate(mainTask.startDate);
        addDate(mainTask.deadline);
        subtasks.forEach(st => {
            addDate(st.startDate);
            addDate(st.deadline);
        });

        // If completely no dates exist, use today
        let minDate = allDates.length > 0 ? new Date(Math.min(...allDates)) : new Date();
        let maxDate = allDates.length > 0 ? new Date(Math.max(...allDates)) : new Date();

        // Ensure max is >= min
        if (minDate > maxDate) {
            const temp = minDate;
            minDate = maxDate;
            maxDate = temp;
        }

        // Pad timeline by 5 days on start and end for breathing room
        minDate.setDate(minDate.getDate() - 5);
        maxDate.setDate(maxDate.getDate() + 5);

        // Generate Array of Days
        const daysArr = [];
        for(let d = new Date(minDate); d <= maxDate; d.setDate(d.getDate() + 1)) {
            daysArr.push(new Date(d));
        }

        // Generate Month Headers
        const monthsArr = [];
        let currentMonth = null;
        let count = 0;
        daysArr.forEach((d, i) => {
            const monthStr = d.toLocaleString('en-US', { month: 'long', year: 'numeric' });
            if (monthStr !== currentMonth) {
                if (currentMonth !== null) monthsArr.push({ label: currentMonth, count });
                currentMonth = monthStr;
                count = 1;
            } else {
                count++;
            }
            if (i === daysArr.length - 1) monthsArr.push({ label: currentMonth, count });
        });

        return { days: daysArr, months: monthsArr, timelineStart: minDate, timelineEnd: maxDate };
    }, [mainTask, subtasks]);

    // --- 2. BAR PLACEMENT HELPER ---
    const getTaskStyles = (task, isMain = false) => {
        let start = task.startDate ? new Date(task.startDate) : (task.deadline ? new Date(task.deadline) : new Date(timelineStart));
        let end = task.deadline ? new Date(task.deadline) : (task.startDate ? new Date(task.startDate) : new Date(timelineEnd));
        
        if (start > end) [start, end] = [end, start];
        start.setHours(0,0,0,0);
        end.setHours(0,0,0,0);

        // Calculate offset and width in "Days" (1 day = 40px)
        const cellWidth = 40;
        
        let startIndex = days.findIndex(d => d.getTime() === start.getTime());
        let endIndex = days.findIndex(d => d.getTime() === end.getTime());
        
        if (startIndex === -1) startIndex = 0;
        if (endIndex === -1) endIndex = days.length - 1;

        const left = startIndex * cellWidth;
        const width = (endIndex - startIndex + 1) * cellWidth;

        // Color based on status
        let bgColor = isMain ? 'bg-indigo-600' : 'bg-blue-500';
        const s = (task.status || '').toLowerCase();
        if (s === 'done' || s === 'completed') bgColor = 'bg-green-500';
        else if (s === 'review' || s === 'follow-up') bgColor = 'bg-yellow-500';

        return { left: `${left}px`, width: `${width}px`, bgColor };
    };

    // --- RENDER ROWS ---
    const renderRow = (task, isMain = false) => {
        const { left, width, bgColor } = getTaskStyles(task, isMain);
        
        return (
            <div key={task.id} className={`flex h-12 items-center border-b border-gray-100 ${isMain ? 'bg-indigo-50/30' : 'hover:bg-gray-50'}`}>
                {/* Left Panel: Task Name */}
                <div className="w-64 shrink-0 px-4 py-2 border-r border-gray-200 bg-white sticky left-0 z-20 flex flex-col justify-center shadow-[2px_0_5px_-2px_rgba(0,0,0,0.05)]">
                    <span className={`text-sm truncate ${isMain ? 'font-black text-indigo-900' : 'font-medium text-gray-700'}`}>
                        {task.title}
                    </span>
                    {!isMain && (
                        <span className="text-[10px] text-gray-400 truncate">
                            {COLUMNS.find(c => c.id === task.status)?.title || task.status}
                        </span>
                    )}
                </div>

                {/* Right Panel: Timeline Cells & Bar */}
                <div className="flex relative h-full">
                    {/* Grid Background Lines */}
                    {days.map((d, i) => {
                        const isWeekend = d.getDay() === 0 || d.getDay() === 6;
                        return (
                            <div 
                                key={i} 
                                className={`w-[40px] shrink-0 border-r border-gray-100 h-full ${isWeekend ? 'bg-gray-50/50' : ''}`}
                            />
                        );
                    })}
                    
                    {/* The Task Bar */}
                    <div 
                        style={{ left, width }} 
                        className={`absolute top-2.5 bottom-2.5 ${bgColor} rounded-md shadow-sm border border-black/10 flex items-center px-2 overflow-hidden transition-all hover:opacity-90 cursor-pointer`}
                        title={`${task.title} \n${new Date(task.startDate || task.deadline).toLocaleDateString()} - ${new Date(task.deadline || task.startDate).toLocaleDateString()}`}
                    >
                        {width !== '40px' && (
                            <span className="text-[10px] font-bold text-white truncate drop-shadow-md">
                                {task.title}
                            </span>
                        )}
                    </div>
                </div>
            </div>
        );
    };

    return (
        <div className="fixed inset-0 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4 z-[110]" onClick={onClose}>
            <div className="bg-white w-full max-w-6xl h-[80vh] rounded-2xl shadow-2xl flex flex-col overflow-hidden animate-in fade-in zoom-in-95" onClick={e => e.stopPropagation()}>
                
                {/* Header */}
                <div className="px-6 py-4 border-b border-gray-200 bg-gray-50 flex justify-between items-center shrink-0">
                    <div className="flex items-center gap-3">
                        <div className="p-2 bg-indigo-100 text-indigo-600 rounded-lg"><Calendar size={20} /></div>
                        <div>
                            <h3 className="font-bold text-gray-900 text-lg leading-tight">Project Timeline</h3>
                            <p className="text-xs text-gray-500 font-medium">Gantt Chart for: {mainTask.title}</p>
                        </div>
                    </div>
                    <button onClick={onClose} className="p-2 bg-gray-200 hover:bg-gray-300 rounded-full transition text-gray-600"><X size={18} /></button>
                </div>

                {/* Legend */}
                <div className="px-6 py-2 border-b border-gray-100 bg-white flex gap-6 text-xs font-bold text-gray-500">
                    <span className="flex items-center gap-1.5"><div className="w-3 h-3 rounded bg-indigo-600"></div> Main Project</span>
                    <span className="flex items-center gap-1.5"><div className="w-3 h-3 rounded bg-blue-500"></div> Pending / In Progress</span>
                    <span className="flex items-center gap-1.5"><div className="w-3 h-3 rounded bg-yellow-500"></div> Review</span>
                    <span className="flex items-center gap-1.5"><div className="w-3 h-3 rounded bg-green-500"></div> Completed</span>
                </div>

                {/* Gantt Chart Area */}
                <div className="flex-1 overflow-auto bg-white flex flex-col relative custom-scrollbar">
                    <div className="w-max min-w-full">
                        
                        {/* Timeline Header Row (Months) */}
                        <div className="flex border-b border-gray-200 h-8 sticky top-0 z-30 bg-gray-50">
                            <div className="w-64 shrink-0 px-4 border-r border-gray-200 sticky left-0 z-40 bg-gray-50 flex items-center text-xs font-bold text-gray-400 uppercase tracking-wider shadow-[2px_0_5px_-2px_rgba(0,0,0,0.05)]">
                                Tasks
                            </div>
                            <div className="flex">
                                {months.map((m, i) => (
                                    <div 
                                        key={i} 
                                        style={{ width: `${m.count * 40}px` }} 
                                        className="shrink-0 border-r border-gray-200 flex items-center justify-center text-[11px] font-bold text-gray-600 bg-gray-100/50"
                                    >
                                        {m.label}
                                    </div>
                                ))}
                            </div>
                        </div>

                        {/* Timeline Header Row (Days) */}
                        <div className="flex border-b border-gray-200 h-8 sticky top-8 z-30 bg-white">
                            <div className="w-64 shrink-0 border-r border-gray-200 sticky left-0 z-40 bg-white shadow-[2px_0_5px_-2px_rgba(0,0,0,0.05)]"></div>
                            <div className="flex">
                                {days.map((d, i) => {
                                    const isWeekend = d.getDay() === 0 || d.getDay() === 6;
                                    const isToday = d.toDateString() === new Date().toDateString();
                                    return (
                                        <div 
                                            key={i} 
                                            className={`w-[40px] shrink-0 border-r border-gray-100 flex flex-col items-center justify-center text-[10px] 
                                                ${isToday ? 'bg-blue-600 text-white font-bold' : isWeekend ? 'bg-gray-50 text-red-400 font-medium' : 'text-gray-500'}
                                            `}
                                        >
                                            <span>{d.getDate()}</span>
                                        </div>
                                    );
                                })}
                            </div>
                        </div>

                        {/* Body Rows */}
                        <div className="flex flex-col relative z-10 pb-10">
                            {renderRow(mainTask, true)}
                            {subtasks.length === 0 ? (
                                <div className="p-8 text-center text-gray-400 text-sm italic sticky left-0">No subtasks available.</div>
                            ) : (
                                subtasks.map(st => renderRow(st, false))
                            )}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    );
}